# Optional — can also be passed as a CLI argument (owner/repo)
GITHUB_REPOSITORY=owner/repo

# Optional — maximum concurrent work items (default: 3)
MAX_CONCURRENCY=3

# Optional — loop interval in milliseconds (default: 60000)
LOOP_INTERVAL_MS=60000

# Optional — Claude model to use
CLAUDE_MODEL=claude-sonnet-4-6

# Optional — path for persisted agent-session state
# VIBRATOR_SESSION_STORE_PATH=/path/to/sessions.json

# ── Multi-account Claude Code rotation ─────────────────────────────────────
#
# Comma- or newline-separated list of paths to Claude Code config directories.
# Each directory must contain a .credentials.json file from a previously
# authenticated Claude Code session (run `claude` once in that directory to
# authenticate each account).
#
# When this variable is set, vibrator starts with the first account and
# rotates to the next one whenever a rate limit is hit. It will not retry an
# account until one minute after its rate limit is known to have reset.
# If all accounts are rate-limited, vibrator waits until the earliest one
# becomes available again.
#
# The Claude CLI reads its config directory from the CLAUDE_HOME environment
# variable, which vibrator sets automatically for each invocation.
#
# Example (two accounts):
# CLAUDE_ACCOUNTS=/home/user/.claude-account1,/home/user/.claude-account2
#
# CLAUDE_ACCOUNTS=

# Optional — path for persisted Claude account rate-limit state
# (defaults to ~/.vibrator/claude-accounts.json)
# CLAUDE_ACCOUNTS_STORE_PATH=/path/to/claude-accounts.json

