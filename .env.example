# Optional — can also be passed as a CLI argument (owner/repo)
GITHUB_REPOSITORY=owner/repo

# Optional — maximum concurrent work items (default: 3)
MAX_CONCURRENCY=3

# Optional — loop interval in milliseconds (default: 60000)
LOOP_INTERVAL_MS=60000

# Optional — path for persisted agent-session state
# VIBRATOR_SESSION_STORE_PATH=/path/to/sessions.json
