# Optional — can also be passed as a CLI argument (owner/repo)
GITHUB_REPOSITORY=owner/repo

# Required — GitHub PAT used for GitHub API and Git operations.
# Prefer VIBRATOR_GITHUB_TOKEN for local use. GITHUB_TOKEN is also supported.
# VIBRATOR_GITHUB_TOKEN=github_pat_...

# Optional — title displayed next to the lightning bolt in the dashboard header (default: Vibrator)
# DASHBOARD_TITLE=Vibrator

# Optional — maximum concurrent work items (default: 3)
MAX_CONCURRENCY=3

# Optional — minimum seconds between engine cycle starts (default: 60)
CYCLE_MINIMUM_SECONDS=60

# Optional — Claude model to use
CLAUDE_MODEL=claude-sonnet-4-6

# Optional — model used for commit message generation (default: claude-haiku-4-5-20251001)
CLAUDE_COMMIT_MODEL=claude-haiku-4-5-20251001

# Optional — path for persisted agent-session state
# VIBRATOR_SESSION_STORE_PATH=/path/to/sessions.json

# ── Human-in-the-Loop (HITL) project mode ──────────────────────────────────
#
# Set GITHUB_PROJECT_NUMBER to the number of the GitHub Project (v2) that
# tracks your repository's issues. When set, vibrator enters **project mode**:
#
#   - Only issues whose project-board status is "Ready" are picked up.
#   - Issues with the "manual" label are always ignored.
#   - When work starts on a Ready issue, it is moved to "In Progress".
#   - After a clean self-review, vibrator requests human review and moves the
#     issue to "In Review" instead of auto-merging.
#   - Auto-merge is disabled; the PR stays open for human review.
#   - Work is re-queued if:
#       • The PR is converted to a draft (human wants more changes).
#       • A new PR comment arrives from a human reviewer.
#       • The issue is moved back to "Ready" on the project board.
#
# GITHUB_PROJECT_NUMBER=1

# Comma-separated list of GitHub logins to request review from when a PR is
# ready for human review (project mode only). Leave empty to skip review
# requests (PR will still be converted from draft to ready-for-review).
#
# VIBRATOR_REVIEWERS=alice,bob
