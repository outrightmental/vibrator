{
  "name": "vibrator",
  "version": "1.0.0",
  "description": "Orchestrator for agentic vibe coding",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:dashboard",
    "build:dashboard": "esbuild src/dashboard/main.ts --bundle --format=esm --sourcemap --outfile=dist/dashboard/bundle.js",
    "watch:dashboard": "esbuild src/dashboard/main.ts --bundle --format=esm --sourcemap --outfile=dist/dashboard/bundle.js --watch",
    "predev": "npm run build:dashboard",
    "dev": "tsx src/index.ts",
    "start": "npm run build && node dist/src/index.js",
    "test": "node --import tsx --test $(find test -name '*.test.ts' | sort)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outrightmental/vibrator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/outrightmental/vibrator/issues"
  },
  "homepage": "https://github.com/outrightmental/vibrator#readme",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "lit": "^3.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "open": "^10.1.0",
    "ws": "^8.17.0"
  }
}
